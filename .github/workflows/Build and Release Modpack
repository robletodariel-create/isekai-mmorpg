name: Build and Release Modpack
on:
  workflow_dispatch:

permissions:
  contents: write
  packages: write
  issues: write

jobs:
  build_and_release:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.11'

      - name: Make scripts executable
        run: |
          chmod +x build_modpack.py || true
          chmod +x build_zip.sh || true

      - name: Debug repo contents
        run: |
          echo "=== CWD ==="
          pwd
          echo "=== List root ==="
          ls -la
          echo "=== List curseforge overrides ==="
          ls -la curseforge/overrides/datapacks/isekai || true
          echo "=== Show curseforge/manifest.json ==="
          if [ -f curseforge/manifest.json ]; then
            echo "--- manifest.json ---"
            sed -n '1,200p' curseforge/manifest.json
            echo "---------------------"
          else
            echo "manifest.json NO existe en curseforge/manifest.json"
          fi
          echo "=== Python ==="
          python3 --version
          echo "=== PWD tree (first 200 lines) ==="
          find . -maxdepth 4 -print | head -n 200

      - name: Build modpack ZIP (CurseForge)
        run: |
          python3 build_modpack.py

      - name: Build datapack ZIP (from curseforge overrides)
        run: |
          if [ -d "curseforge/overrides/datapacks/isekai" ]; then
            echo "Creating datapack ZIP from curseforge/overrides/datapacks/isekai..."
            pushd curseforge/overrides/datapacks/isekai
            zip -r ../../../../isekai_races_v0.1.zip pack.mcmeta data || true
            popd
          elif [ -d "datapack/isekai" ]; then
            echo "Creating datapack ZIP from datapack/isekai..."
            pushd datapack/isekai
            zip -r ../../isekai_races_v0.1.zip pack.mcmeta data || true
            popd
          else
            echo "No datapack source found; skipping datapack ZIP creation"
          fi

      - name: Create GitHub Release
        id: create_release
        uses: actions/create-release@v1
        with:
          tag_name: isekai-v${{ github.run_number }}
          release_name: Isekai Races v${{ github.run_number }}
          body: |
            Release creado automáticamente por workflow. Incluye los ZIPs del modpack/curseforge y del datapack.
          draft: false
          prerelease: false
          token: ${{ secrets.GITHUB_TOKEN }}

      - name: Upload CurseForge ZIP (if exists)
        run: |
          if [ -f isekai_races_v0.1_curseforge.zip ]; then
            echo "Uploading isekai_races_v0.1_curseforge.zip"
            gh release upload --clobber ${{ steps.create_release.outputs.tag_name }} isekai_races_v0.1_curseforge.zip
          else
            echo "CurseForge ZIP not found; skipping upload"
          fi
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      - name: Upload Datapack ZIP (if exists)
        run: |
          if [ -f isekai_races_v0.1.zip ]; then
            echo "Uploading isekai_races_v0.1.zip"
            gh release upload --clobber ${{ steps.create_release.outputs.tag_name }} isekai_races_v0.1.zip
          else
            echo "Datapack ZIP not found; skipping upload"
          fi
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      - name: Output release URL
        run: |
          echo "Release published: ${{ steps.create_release.outputs.html_url }}"
